{
  "name": "nestjs-abort-controller",
  "version": "1.3.1",
  "description": "AbortController integration for NestJS: request-scoped cancellation using AbortSignal.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "nestjs",
    "abortcontroller",
    "cancellation",
    "abort",
    "abort-signal",
    "request-cancellation",
    "middleware",
    "typescript"
  ],
  "author": "Ferhat Yalçın",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ylcnfrht/nestjs-abort-controller.git"
  },
  "bugs": {
    "url": "https://github.com/ylcnfrht/nestjs-abort-controller/issues"
  },
  "homepage": "https://github.com/ylcnfrht/nestjs-abort-controller#readme",
  "engines": {
    "node": ">=16.0.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "reflect-metadata": "^0.1.12 || ^0.2.0",
    "rxjs": "^7.1.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.5",
    "@nestjs/core": "^11.1.5",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/platform-fastify": "^11.2.7",
    "@nestjs/testing": "^11.1.5",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.0.0",
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "express": "^5.1.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0"
  }
}
