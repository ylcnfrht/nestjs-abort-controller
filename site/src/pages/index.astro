---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Code, Tabs, TabItem } from '@astrojs/starlight/components';
import SignalField from '../components/landing/SignalField.astro';
import Illustration from '../components/landing/Illustration.astro';
import HeroDemo, { HERO_CODE } from '../components/HeroDemo.tsx';

const description = 'Request cancellation for NestJS: an AbortSignal per request that aborts when the client disconnects or a timeout fires. Express and Fastify.';

const bento = [
  {
    kind: 'real',
    tag: 'Per request',
    title: 'Every request gets its own AbortSignal.',
    body: 'One middleware, registered by AbortControllerModule. The signal is a native AbortSignal: hand it to fetch, database drivers, fs/promises, timers/promises and anything else that takes one.',
    href: '/concepts/how-it-works/',
    wide: true,
    code: `@Get(':id')
find(@Param('id') id: string, @NestAbortSignal() signal: AbortSignal) {
  return fetch(\`\${API}/users/\${id}\`, { signal });
}`,
  },
  {
    kind: 'register',
    tag: 'Disconnects',
    title: 'The client left. Stop working.',
    body: 'When the connection closes before the response is sent, the signal aborts. Finished responses and POST bodies never trigger it.',
    href: '/concepts/client-disconnects/',
    code: `// abort reason
new AbortError('Client disconnected', 'client-disconnected')`,
  },
  {
    kind: 'reset',
    tag: 'Timeout',
    title: 'A deadline for every request.',
    body: '30 seconds by default, per module or per route group. 0 turns it off. The timer is cleared when the response ends.',
    href: '/concepts/timeouts/',
    code: `AbortControllerModule.forRoutes(['/reports/*path'], {
  timeout: 120_000,
})`,
  },
  {
    kind: 'errors',
    tag: 'Errors',
    title: 'Know why it stopped.',
    body: "AbortError.reason is 'timeout' or 'client-disconnected'. throwIfAborted() rethrows the middleware's own error, so the reason survives.",
    href: '/concepts/abort-errors/',
    code: `catch (error) {
  if (error instanceof AbortError) log(error.reason);
}`,
  },
  {
    kind: 'dispose',
    tag: 'Responses',
    title: '408 for timeouts, silence for the gone.',
    body: 'The optional AbortExceptionFilter answers timeouts with 408 Request Timeout and sends nothing to a client that already left.',
    href: '/concepts/error-responses/',
    code: `providers: [
  { provide: APP_FILTER, useClass: AbortExceptionFilter },
]`,
  },
  {
    kind: 'linked',
    tag: 'Anywhere',
    wide: true,
    title: 'Guards, interceptors and Fastify too.',
    body: 'The controller and signal live on the Node request under symbol keys. Read them anywhere you have the request. Fastify works the same: the decorator looks in req.raw for you.',
    href: '/concepts/outside-controllers/',
    code: `const req = context.switchToHttp().getRequest();
const signal: AbortSignal = req[ABORT_SIGNAL] ?? req.raw?.[ABORT_SIGNAL];`,
  },
] as const;

const toolbox = [
  {
    title: 'Module',
    items: [
      ['forRoot(options?)', 'All routes'],
      ['forRoutes(routes, options?)', 'Some routes'],
      ['timeout', 'ms, default 30000, 0 = off'],
      ['enableLogging', 'Debug / warn logs'],
    ],
  },
  {
    title: 'Handlers',
    items: [
      ['@NestAbortSignal()', 'Inject the signal'],
      ['throwIfAborted(signal)', 'Checkpoint in loops'],
      ['signal.aborted · reason', 'Native AbortSignal'],
    ],
  },
  {
    title: 'Errors',
    items: [
      ['AbortError', 'name, message, reason'],
      ["'timeout'", 'Deadline hit'],
      ["'client-disconnected'", 'Connection closed early'],
      ['AbortExceptionFilter', '408 / no response'],
    ],
  },
  {
    title: 'Low level',
    items: [
      ['ABORT_SIGNAL', 'Symbol key on the request'],
      ['ABORT_CONTROLLER', 'Abort it yourself'],
      ['AbortControllerMiddleware', 'Apply it manually'],
    ],
  },
];

const inCode = {
  services: `@Injectable()
export class SearchService {
  constructor(private readonly http: HttpService) {}

  async search(query: string, signal: AbortSignal) {
    const [a, b] = await Promise.all([
      fetch(\`\${A}?q=\${query}\`, { signal }).then((r) => r.json()),
      firstValueFrom(this.http.get(B, { params: { q: query }, signal })),
    ]);
    return merge(a, b.data);
  }
}`,
  loops: `@Post('import')
async import(@Body() rows: Row[], @NestAbortSignal() signal: AbortSignal) {
  let done = 0;
  for (const row of rows) {
    throwIfAborted(signal); // cheap check between units of work
    await this.repo.upsert(row);
    done++;
  }
  return { done };
}`,
  fastify: `const app = await NestFactory.create<NestFastifyApplication>(
  AppModule,
  new FastifyAdapter(),
);
// Nothing else changes: same module, same decorator.`,
  interceptor: `@Injectable()
export class SlowLogInterceptor implements NestInterceptor {
  intercept(context: ExecutionContext, next: CallHandler) {
    const req = context.switchToHttp().getRequest();
    const signal: AbortSignal | undefined = req[ABORT_SIGNAL] ?? req.raw?.[ABORT_SIGNAL];
    signal?.addEventListener('abort', () => logger.warn(\`\${req.url}: \${signal.reason.reason}\`));
    return next.handle();
  }
}`,
};
---

<StarlightPage frontmatter={{ title: 'nestjs-abort-controller', description, template: 'splash', pagefind: false }}>
  <div class="io-landing not-content">
    <section class="hero">
      <SignalField />
      <div class="hero-inner">
        <a class="badge" href="/reference/changelog/"><span class="dot"></span>1.3 · Express + Fastify · ~3M downloads a year</a>
        <h1>Stop work<br /><span>nobody is waiting for.</span></h1>
        <p class="lede">
          Every NestJS request gets an AbortSignal. It aborts when the client disconnects or the request runs past its timeout,
          so database queries, fetch calls and loops stop instead of finishing for nobody.
        </p>
        <div class="actions">
          <a class="btn primary" href="/start/quick-start/">Get started</a>
          <a class="btn ghost" href="/concepts/how-it-works/">How it works</a>
        </div>
        <button class="install" type="button" data-copy="npm i nestjs-abort-controller">
          <span class="prompt">$</span> npm i nestjs-abort-controller <span class="copy">copy</span>
        </button>
      </div>
      <div class="hero-code">
        <Code code={HERO_CODE} lang="ts" title="app.module.ts · report.controller.ts" />
        <HeroDemo client:visible />
      </div>
    </section>

    <section class="stats" aria-label="At a glance">
      <div><strong>0</strong><span>runtime dependencies</span></div>
      <div><strong>AbortSignal</strong><span>native, per request</span></div>
      <div><strong>30 s</strong><span>default timeout</span></div>
      <div><strong>NestJS 11</strong><span>Express + Fastify</span></div>
      <div><strong>~136k</strong><span>weekly downloads</span></div>
    </section>

    <section class="section">
      <p class="io-eyebrow">What it adds</p>
      <h2>One module. Cancellation everywhere.</h2>
      <div class="bento">
        {bento.map((b) => (
          <article class:list={['card', { wide: 'wide' in b && b.wide }]}>
            {'wide' in b && b.wide && <div class="art"><Illustration kind={b.kind} /></div>}
            <div class="card-body">
              <span class="tag">{b.tag}</span>
              <h3>{b.title}</h3>
              <p>{b.body}</p>
              <a class="more" href={b.href}>Read more <span aria-hidden="true">→</span></a>
            </div>
            <div class="card-code"><Code code={b.code} lang="ts" /></div>
          </article>
        ))}
      </div>
    </section>

    <section class="section">
      <p class="io-eyebrow">The toolbox</p>
      <h2>Small on purpose. The whole API fits here.</h2>
      <div class="toolbox">
        {toolbox.map((group) => (
          <div>
            <h3>{group.title}</h3>
            <ul>
              {group.items.map(([api, desc]) => (
                <li><code>{api}</code><span>{desc}</span></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="section">
      <p class="io-eyebrow">In code</p>
      <h2>Pass the signal down. That is the whole trick.</h2>
      <div class="incode">
        <Tabs>
          <TabItem label="Services"><Code code={inCode.services} lang="ts" /></TabItem>
          <TabItem label="Long loops"><Code code={inCode.loops} lang="ts" /></TabItem>
          <TabItem label="Fastify"><Code code={inCode.fastify} lang="ts" /></TabItem>
          <TabItem label="Interceptor"><Code code={inCode.interceptor} lang="ts" /></TabItem>
        </Tabs>
      </div>
    </section>

    <section class="cta">
      <SignalField intensity="quiet" />
      <div class="cta-inner">
        <p class="io-eyebrow">Get started</p>
        <h2>Import the module. Inject the signal.</h2>
        <p class="lede">Two lines to start. Then pass the signal to whatever does the slow work.</p>
        <div class="actions">
          <a class="btn primary" href="/start/quick-start/">Read the quick start</a>
          <a class="btn ghost" href="/migration/1-2-to-1-3/">Upgrading from 1.2?</a>
        </div>
      </div>
    </section>

    <footer class="foot">
      <span>nestjs-abort-controller · MIT licensed</span>
      <nav aria-label="Footer">
        <a href="/start/introduction/">Docs</a>
        <a href="/reference/changelog/">Changelog</a>
        <a href="https://github.com/ylcnfrht/nestjs-abort-controller">GitHub</a>
        <a href="https://www.npmjs.com/package/nestjs-abort-controller">npm</a>
      </nav>
    </footer>
  </div>
</StarlightPage>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(button.dataset.copy!);
      const label = button.querySelector('.copy');
      if (!label) return;
      label.textContent = 'copied';
      setTimeout(() => (label.textContent = 'copy'), 1400);
    });
  }
</script>

