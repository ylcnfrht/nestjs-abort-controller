    padding-top: 6.5rem;
  }
  .section h2,
  .cta h2 {
    margin: 0.7rem 0 2.2rem;
    font-size: clamp(1.7rem, 1.3rem + 1.4vw, 2.5rem);
    letter-spacing: -0.035em;
    line-height: 1.1;
    font-weight: 620;
    color: var(--sl-color-white);
    max-width: 34rem;
  }

  /* Bento */
  .bento {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .card {
